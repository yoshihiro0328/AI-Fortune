# Unbound template; not authorization to create resources or enable production.
# Configure only on the exact approved Production project, never Preview.
APP_RUNTIME=production
VERCEL_ENV=production
# Exact approved origin and project; VERCEL_PROJECT_ID is platform-provided.
# Do not copy values from an existing review project.
PRODUCTION_PUBLIC_ORIGIN=
PRODUCTION_VERCEL_PROJECT_ID=
PRODUCTION_ENVIRONMENT_ID=
PRODUCTION_SUPABASE_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
CRON_SECRET=
OPENAI_MODEL=gpt-6-luna
OPENAI_CHAT_MODEL=gpt-6-luna
PRODUCTION_OPENAI_PROJECT_ID=
OPENAI_API_KEY=
STRIPE_MODE=live
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_CHECKOUT_ENABLED=false
# Only after the owner approves public facts and operating policies; not a legal certification.
PUBLIC_POLICIES_APPROVED=false
OPERATOR_NAME=
OPERATOR_REPRESENTATIVE=
OPERATOR_ADDRESS=
OPERATOR_PHONE=
OPERATOR_EMAIL=
DATA_RETENTION_POLICY=
REFUND_REQUEST_PERIOD=
SUPPORT_RESPONSE_TIME=
PAYMENT_INTEGRATION_LOCAL=false
SUBSCRIPTION_INTEGRATION_LOCAL=false
PREVIEW_DEMO_ENABLED=false
TRIAL_ENABLED=false
# App auth signup/resend/recovery gate; SMTP is configured separately in Supabase.
# Enable only after the approved production sender and delivery acceptance pass.
AUTH_EMAIL_ENABLED=false
MAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CONTACT_NOTIFY_TO=
OPERATOR_USER_IDS=
# DB production_controls must be separately bound and explicitly approved.
# No seeded limits, no automatic enablement, no automatic unknown-hold release.
